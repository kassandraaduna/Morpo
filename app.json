{
  "expo": {
    "name": "MyphoLens",
    "slug": "MyphoLens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mypholens_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mypholens_logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mypholens_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.MyphoLens"
    },
    "web": {
      "favicon": "./assets/mypholens_logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "2e7ca1e1-85a9-4e2a-981e-84e6cb6e149e"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
