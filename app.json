{
  "expo": {
    "name": "MyphoLens",
    "slug": "MyphoLens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mypholens-logo-sq.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mypholens-logo-sq.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.m2kp.mypholens",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mypholens-logo-sq.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.MyphoLens"
    },
    "web": {
      "favicon": "./assets/mypholens-logo-sq.png"
    },
    "extra": {
      "eas": {
        "projectId": "ec7ec619-936a-4e99-ab8d-72b38dd5f9a3"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "owner": "martinacelso"
  }
}
